{
  "name": "minmo-driver-pack",
  "version": "4.10.2",
  "description": "Minmo Driver Pack — F1 25 Setup + Telemetry Suite",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:win:unsigned": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --config.forceCodeSigning=false"
  },
  "build": {
    "appId": "engineer.frc.setup-manager",
    "productName": "Minmo Driver Pack",
    "publish": [
      {
        "provider": "github",
        "owner": "kangmomin",
        "repo": "frc.engineer-deploy"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../../build/artifacts/frc-pitwall-sender.exe",
        "to": "sender/frc-pitwall-sender.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Minmo-Driver-Pack-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Minmo-Driver-Pack-Portable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "wait-on": "^8.0.3"
  }
}
